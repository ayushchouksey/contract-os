# Server
NODE_ENV=production
PORT=10000
HOST=0.0.0.0

# PostgreSQL (Neon recommended for free tier)
# Use the direct connection: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLED-EP/db?sslmode=require

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS - comma separated list of allowed origins
CORS_ORIGIN=https://your-app.vercel.app,http://localhost:3000

# AI provider: mock (no external calls) or ollama
AI_PROVIDER=mock

# Document storage driver: local (dev) or r2 (Cloudflare R2 for free persistent storage)
STORAGE_DRIVER=r2

# Cloudflare R2 (only required when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Local driver upload dir (dev only)
UPLOAD_DIR=uploads